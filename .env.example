DEBUG=True
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=aonegt_db
DB_USER=postgres
# Required for PostgreSQL unless the server uses trust auth for this user.
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Local dev: console backend prints emails. For SMTP, set EMAIL_HOST_* and use smtp backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=yasminp32@gmail.com
EMAIL_HOST_PASSWORD=vaxwjwwfvoapbzxh
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=yasminp32@gmail.com
FRONTEND_RESET_URL=http://localhost:8000/reset-password

# Production (DEBUG=False): comma-separated origins, no spaces unless part of URL.
CORS_ALLOWED_ORIGINS=https://app.example.com

# Zoho OAuth access token (refresh periodically). Required when REGISTER_REQUIRE_ZOHO_CONTACT is true.
# Scopes: ZohoInventory.contacts.READ (inventory), ZohoCommerce.salesorders.READ (Commerce orders),
#         ZohoCommerce.items.READ (Commerce products proxy under /api/catalog/zoho-commerce/products/),
#         ZohoBooks.salesorders.CREATE, ZohoBooks.invoices.CREATE, ZohoBooks.contacts.CREATE,
#         ZohoBooks.contacts.READ, ZohoBooks.customerpayments.CREATE (Books orders/invoices/payments).
ZOHO_ACCESS_TOKEN=

ZOHO_INVENTORY_ORGANIZATION_ID=
ZOHO_API_BASE_HOST=https://www.zohoapis.com

# Registration gate: require email to exist in Zoho before POST /api/auth/register/ succeeds.
# Zoho Commerce: set REGISTER_ZOHO_EMAIL_SOURCE to commerce_salesorders (or commerce / zoho_commerce).
# Commerce checks sales orders with this email (not “customer with zero orders”).
REGISTER_REQUIRE_ZOHO_CONTACT=false
REGISTER_ZOHO_EMAIL_SOURCE=inventory
ZOHO_COMMERCE_ORGANIZATION_ID=

# Set False to skip Commerce sales order sync at checkout (use Zoho Books SO + invoice on confirm).
ZOHO_COMMERCE_CREATE_SALES_ORDER_ENABLED=False

# ZohoCommerceService: OAuth refresh + storefront (domain-name header). Optional if you only use ZOHO_ACCESS_TOKEN.
# ZOHO_ORG_ID defaults to ZOHO_COMMERCE_ORGANIZATION_ID when unset.
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_COMMERCE_BASE_URL=https://commerce.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_STORE_DOMAIN=
# ZOHO_ORG_ID=

# Best deals: Zoho storefront collection (Own Store example).
# ZOHO_BEST_DEALS_SOURCE=collection
# ZOHO_BEST_DEALS_COLLECTION_ID=1706707000000081241
# ZOHO_BEST_DEALS_COLLECTION_NAME=Best Deals
# List collections: GET /zoho/multi/collections/?store_id=6
# Best deals: GET /zoho/multi/best-deals/?store_id=6&collection_name=Best Deals

# Multi-store: per Store set zoho_org_id, zoho_store_domain, optional OAuth (client_id, etc.).
# Product APIs: ?store_id=<Store.pk>. Falls back to ZOHO_* env when store fields are empty.
# When store_id is omitted, ZOHO_STORE_DOMAIN and ZOHO_COMMERCE_ORGANIZATION_ID are used.

# Zoho Books manual workflow (recommended):
#   checkout → Books sales order | staff edit → update SO | staff → invoice | staff → payment
# ZOHO_BOOKS_MANUAL_WORKFLOW=True
# ZOHO_BOOKS_CREATE_INVOICE_ENABLED=True
# ZOHO_BOOKS_CREATE_SALES_ORDER_ENABLED=True
# ZOHO_BOOKS_CREATE_SALES_ORDER_ON=placed
# ZOHO_BOOKS_INVOICE_FROM_SALES_ORDER=True
# ZOHO_COMMERCE_CREATE_SALES_ORDER_ENABLED=False
# ZOHO_BOOKS_ORGANIZATION_ID=
# ZOHO_BOOKS_VAT_TAX_ID=
# Staff endpoints: POST .../orders/<id>/payment-success/ (gateway credit)
#   .../zoho-books/cancel/ .../zoho-books/invoice/ .../zoho-books/payment/?store_id=

# true = require POST /api/auth/request-registration-code/ then registration_otp on register.
REGISTER_REQUIRE_EMAIL_OTP=false

# Local testing only: skip admin login OTP (POST /api/admin/auth/login/ returns JWT directly).
# Never set true in production.
ADMIN_LOGIN_SKIP_OTP=false

# false = server uses DEFAULT_SHIPPING_AMOUNT only (recommended). true = accept client shipping_amount (dev).
CHECKOUT_TRUST_CLIENT_SHIPPING=false
DEFAULT_SHIPPING_AMOUNT=0
DEFAULT_VAT_PERCENT=5.00

# Geidea Pay by Link
GEIDEA_PAYLINK_URL=https://api.merchant.geidea.net/payment-intent/api/v1/direct/eInvoice
# Optional: defaults to GEIDEA_CALLBACK_URL when unset
GEIDEA_PAYLINK_CALLBACK_URL=
GEIDEA_REFUND_URL=https://api.merchant.geidea.net/pgw/api/v2/direct/refund
GEIDEA_PAYLINK_EXPIRY_DAYS=7
